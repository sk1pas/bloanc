<% content_for :title, @loan_offer.title %>

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1 class="h3 mb-0"><%= @loan_offer.title %></h1>
	<div class="d-flex gap-2">
		<%= link_to t("actions.edit"), edit_admin_loan_offer_path(@loan_offer), class: "btn btn-outline-info" %>
		<%= link_to t("actions.back"), admin_loan_offers_path, class: "btn btn-outline-light" %>
	</div>
</div>

<div class="row g-3 mb-4">
	<div class="col-lg-6">
		<div class="card h-100">
			<div class="card-body">
				<p class="mb-1"><strong><%= t("admin.loan_offers.table.bank") %>:</strong> <%= @loan_offer.bank.title %></p>
				<p class="mb-1"><strong><%= t("admin.loan_offers.table.rate_type") %>:</strong> <%= t("admin.loan_offers.table.rate_type_#{@loan_offer.rate_type}") %></p>
				<% if @loan_offer.fixed_period? %>
					<p class="mb-1"><strong>Fixed phase:</strong> <%= @loan_offer.fixed_rate_percent %>% for <%= @loan_offer.fixed_rate_years %> years</p>
				<% end %>
				<p class="mb-1"><strong><%= t("admin.loan_offers.table.margin") %>:</strong> <%= @loan_offer.bank_margin_percent %>%</p>
				<p class="mb-1"><strong><%= t("admin.loan_offers.table.wibor") %>:</strong> <%= @loan_offer.wibor_kind.upcase %></p>
				<p class="mb-1"><strong><%= t("admin.loan_offers.table.commission") %>:</strong> <%= @loan_offer.bank_commission_percent %>%</p>
				<p class="mb-0"><strong><%= t("admin.loan_offers.table.active") %>:</strong> <%= @loan_offer.active? ? t("common.yes") : t("common.no") %></p>
			</div>
		</div>
	</div>
	<div class="col-lg-6">
		<div class="card h-100">
			<div class="card-body">
				<h2 class="h5"><%= t("admin.loan_offers.details") %></h2>
				<p class="mb-1"><strong>Promotion:</strong> <%= [@loan_offer.promoted_from, @loan_offer.promoted_until].compact.map { |v| I18n.l(v) }.join(" - ").presence || "-" %></p>
				<p class="mb-1"><strong>Life insurance %:</strong> <%= @loan_offer.life_insurance_percent || "-" %></p>
				<p class="mb-1"><strong>Life insurance years:</strong> <%= @loan_offer.life_insurance_years || "-" %></p>
				<p class="mb-1"><strong>Life insurance total:</strong> <%= @loan_offer.life_insurance_total || "-" %></p>
				<p class="mb-1"><strong>Property insurance monthly:</strong> <%= @loan_offer.property_insurance_monthly %></p>
				<p class="mb-0"><strong>Description:</strong> <%= @loan_offer.description.presence || "-" %></p>
			</div>
		</div>
	</div>
</div>

<div class="table-box">
	<div class="p-3 border-bottom d-flex justify-content-between align-items-center">
		<h2 class="h5 mb-0"><%= t("admin.loan_offers.history") %></h2>
		<%= link_to t("admin.loan_offers.full_history"), admin_loan_offer_loan_offer_changes_path(@loan_offer), class: "btn btn-sm btn-outline-light" %>
	</div>
	<div class="table-responsive">
		<table class="table mb-0">
			<thead class="admin-table-head">
				<tr>
					<th><%= t("admin.dashboard.change_date") %></th>
					<th><%= t("admin.dashboard.note") %></th>
				</tr>
			</thead>
			<tbody>
				<% @changes.each do |change| %>
					<tr>
						<td><%= l(change.changed_at) %></td>
						<td><%= change.note.presence || "-" %></td>
					</tr>
				<% end %>
			</tbody>
		</table>
	</div>
</div>
