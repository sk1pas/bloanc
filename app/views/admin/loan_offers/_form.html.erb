<% latest_snapshot = WiborSnapshot.latest %>

<div data-controller="life-insurance-calc life-insurance-period"
     data-life-insurance-calc-wibor1m-value="<%= latest_snapshot&.wibor_1m.to_f %>"
     data-life-insurance-calc-wibor3m-value="<%= latest_snapshot&.wibor_3m.to_f %>">
  <%= form_with model: [:admin, @loan_offer], class: "card admin-form-card" do |form| %>
    <div class="card-body row g-3">
      <% if @loan_offer.errors.any? %>
        <div class="col-12 alert alert-danger">
          <ul class="mb-0">
            <% @loan_offer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="col-md-6 col-lg-4">
        <%= form.label :bank_id, "Bank", class: "form-label" %>
        <%= form.collection_select :bank_id, @banks, :id, :title, {}, class: "form-select" %>
      </div>
      <div class="col-md-6 col-lg-4">
        <%= form.label :title, "Offer title", class: "form-label" %>
        <%= form.text_field :title, class: "form-control" %>
      </div>
      <div class="col-md-6 col-lg-4">
        <%= form.label :url, "Offer URL", class: "form-label" %>
        <%= form.url_field :url, class: "form-control", placeholder: "https://" %>
      </div>
      <div class="col-md-6 col-lg-3 d-flex align-items-end">
        <div class="form-check">
          <%= form.check_box :active, class: "form-check-input" %>
          <%= form.label :active, "Active offer", class: "form-check-label" %>
        </div>
      </div>

      <div class="col-12 col-lg-8">
        <%= form.label :description, "Offer description", class: "form-label" %>
        <%= form.text_area :description, class: "form-control", rows: 3 %>
      </div>

      <div class="col-md-6 col-lg-3">
        <%= form.label :promoted_from, "Promo from (date)", class: "form-label" %>
        <%= form.date_field :promoted_from, class: "form-control" %>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :promoted_until, "Promo until (date)", class: "form-label" %>
        <%= form.date_field :promoted_until, class: "form-control" %>
      </div>

      <div class="col-12"><hr></div>

      <div class="col-md-6 col-lg-3">
        <%= form.label :rate_type, "Rate type", class: "form-label" %>
        <%= form.select :rate_type,
                        [["Variable", "variable"], ["Fixed period then variable", "fixed_period"]],
                        {},
                        class: "form-select" %>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :fixed_rate_percent, "Fixed rate (%)", class: "form-label" %>
        <%= form.number_field :fixed_rate_percent, class: "form-control", step: "0.001" %>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :fixed_rate_years, "Fixed period (years)", class: "form-label" %>
        <%= form.number_field :fixed_rate_years, class: "form-control", step: 1 %>
      </div>

      <div class="col-md-6 col-lg-3">
        <%= form.label :bank_margin_percent, "Bank margin (%)", class: "form-label" %>
        <%= form.number_field :bank_margin_percent, class: "form-control", step: "0.001", required: true %>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :wibor_kind, "WIBOR reference", class: "form-label" %>
        <%= form.select :wibor_kind, LoanOffer.wibor_kinds.keys.map { |kind| [kind.upcase, kind] }, {}, class: "form-select" %>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :bank_commission_percent, "Bank commission (%)", class: "form-label" %>
        <%= form.number_field :bank_commission_percent, class: "form-control", step: "0.001" %>
      </div>

      <div class="col-12 col-lg-9">
        <p class="form-hint mb-0"><%= t("admin.loan_offers.form.percent_hint") %></p>
      </div>

      <div class="col-12 col-lg-9">
        <p class="form-hint mb-0">
          <% if latest_snapshot.present? %>
            <%= t("admin.loan_offers.form.latest_wibor") %>:
            1M: <strong><%= latest_snapshot.wibor_1m %>%</strong>,
            3M: <strong><%= latest_snapshot.wibor_3m %>%</strong>,
            <%= I18n.l(latest_snapshot.effective_date) %>
          <% else %>
            <%= t("admin.loan_offers.form.no_wibor") %>
          <% end %>
        </p>
      </div>

      <div class="col-12"><hr></div>

      <div class="col-md-6 col-lg-3">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <%= form.label :life_insurance_percent, "Life insurance (%)", class: "form-label mb-0" %>
          <button type="button"
                  class="btn btn-sm btn-outline-info"
                  data-action="life-insurance-calc#open">
            Calc
          </button>
        </div>
        <%= form.number_field :life_insurance_percent,
                              class: "form-control mt-2",
                              step: "0.0001",
                              data: { life_insurance_calc_target: "percentField" } %>
        <div class="form-check mt-2">
          <%= form.check_box :life_insurance_one_time,
                             class: "form-check-input",
                             data: {
                               life_insurance_period_target: "oneTime",
                               action: "change->life-insurance-period#toggle"
                             } %>
          <%= form.label :life_insurance_one_time, "One-time payment (% of loan)", class: "form-check-label" %>
        </div>
        <div class="form-hint">Leave blank if unknown. Monthly % of remaining principal, or one-time % of the loan amount.</div>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :life_insurance_years, "Life insurance period (years)", class: "form-label" %>
        <%= form.number_field :life_insurance_years,
                              class: "form-control",
                              step: 1,
                              data: {
                                life_insurance_calc_target: "yearsField",
                                life_insurance_period_target: "yearsField"
                              } %>
        <div class="form-check mt-2">
          <%= form.check_box :life_insurance_full_term,
                             class: "form-check-input",
                             data: {
                               life_insurance_period_target: "fullTerm",
                               action: "change->life-insurance-period#toggle"
                             } %>
          <%= form.label :life_insurance_full_term, "Whole loan period", class: "form-check-label" %>
        </div>
        <div class="form-hint">Charge monthly % until the loan is fully repaid.</div>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :life_insurance_total, "Life insurance total (PLN, one-time)", class: "form-label" %>
        <%= form.number_field :life_insurance_total,
                              class: "form-control",
                              step: "0.01",
                              data: {
                                life_insurance_calc_target: "totalField",
                                life_insurance_period_target: "totalField"
                              } %>
        <div class="form-hint">If set, overrides monthly % calculation. Ignored for one-time % of loan.</div>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :property_insurance_monthly, "Property insurance (PLN/month)", class: "form-label" %>
        <%= form.number_field :property_insurance_monthly, class: "form-control", step: "0.01" %>
        <div class="form-hint">Leave blank if unknown</div>
      </div>

      <div class="col-12"><hr></div>

      <div class="col-md-6 col-lg-3">
        <%= form.label :overpayment_penalty_years, "Overpayment penalty period (years)", class: "form-label" %>
        <%= form.number_field :overpayment_penalty_years, class: "form-control", step: 1 %>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :overpayment_penalty_percent, "Overpayment penalty (%)", class: "form-label" %>
        <%= form.number_field :overpayment_penalty_percent, class: "form-control", step: "0.01" %>
      </div>
      <div class="col-md-6 col-lg-3">
        <%= form.label :overpayment_penalty_min_amount, "Overpayment penalty minimum (PLN)", class: "form-label" %>
        <%= form.number_field :overpayment_penalty_min_amount, class: "form-control", step: "0.01" %>
      </div>

      <% if @loan_offer.persisted? %>
        <div class="col-12"><hr></div>
        <div class="col-md-6 col-lg-4 d-flex align-items-end">
          <div class="form-check">
            <%= check_box_tag :save_history, "1", false, class: "form-check-input", id: "save_history" %>
            <%= label_tag "save_history", t("admin.loan_offers.form.save_history"), class: "form-check-label" %>
          </div>
        </div>
        <div class="col-md-6 col-lg-5">
          <%= label_tag :history_note, t("admin.loan_offers.form.history_note"), class: "form-label" %>
          <%= text_field_tag :history_note, nil, class: "form-control" %>
        </div>
      <% end %>

      <div class="col-12 d-flex justify-content-between">
        <%= link_to t("actions.back"), admin_loan_offers_path, class: "btn btn-outline-light" %>
        <%= form.submit class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>

  <%# Keep calculator inputs outside the offer form so browser validation never blocks submit. %>
  <div class="modal fade" tabindex="-1" aria-hidden="true" data-life-insurance-calc-target="modal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content bg-dark text-light">
        <div class="modal-header border-secondary">
          <h2 class="modal-title h5 mb-0">Life insurance % calculator</h2>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="small text-secondary">
            Each month the insurer charges a % of the <em>remaining loan principal</em>.
            Total bank interest is not an input — we only need the annual rate so we can
            rebuild how the principal declines (annuity schedule), then solve:
            <code>monthly % = total insurance × 100 / sum(remaining balances)</code>.
          </p>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="life_ins_calc_loan_amount">Loan amount (PLN)</label>
              <input id="life_ins_calc_loan_amount"
                     type="number"
                     class="form-control"
                     step="any"
                     data-life-insurance-calc-target="loanAmount">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="life_ins_calc_loan_months">Loan period (months)</label>
              <input id="life_ins_calc_loan_months"
                     type="number"
                     class="form-control"
                     step="1"
                     value="300"
                     data-life-insurance-calc-target="loanMonths">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="life_ins_calc_annual_rate">Annual interest rate (%)</label>
              <input id="life_ins_calc_annual_rate"
                     type="number"
                     class="form-control"
                     step="any"
                     data-life-insurance-calc-target="annualRate">
              <div class="form-hint">Usually bank margin + WIBOR (or fixed rate).</div>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="life_ins_calc_insurance_years">Insurance period (years)</label>
              <input id="life_ins_calc_insurance_years"
                     type="number"
                     class="form-control"
                     step="1"
                     data-life-insurance-calc-target="insuranceYears">
            </div>
            <div class="col-12">
              <label class="form-label" for="life_ins_calc_insurance_total">Total life insurance over that period (PLN)</label>
              <input id="life_ins_calc_insurance_total"
                     type="number"
                     class="form-control"
                     step="any"
                     data-life-insurance-calc-target="insuranceTotal">
            </div>
          </div>

          <div class="alert alert-danger mt-3 mb-0" hidden data-life-insurance-calc-target="error"></div>
          <div class="alert alert-info mt-3 mb-0" hidden data-life-insurance-calc-target="result"></div>
        </div>
        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-outline-info" data-action="life-insurance-calc#calculate">Calculate</button>
          <button type="button" class="btn btn-primary" data-action="life-insurance-calc#apply">Apply to form</button>
        </div>
      </div>
    </div>
  </div>
</div>
