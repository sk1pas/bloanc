<% content_for :title, @bank.title %>

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1 class="h3 mb-0"><%= @bank.title %></h1>
	<div class="d-flex gap-2">
		<%= link_to t("actions.edit"), edit_admin_bank_path(@bank), class: "btn btn-outline-info" %>
		<%= link_to t("actions.back"), admin_banks_path, class: "btn btn-outline-light" %>
	</div>
</div>

<div class="row g-3 mb-4">
	<div class="col-lg-4">
		<div class="card h-100">
			<div class="card-body">
				<% if @bank.logo.attached? %>
					<%= image_tag @bank.logo, class: "bank-logo mb-3", alt: @bank.title %>
				<% end %>
				<p class="mb-1"><strong><%= t("admin.banks.table.website") %>:</strong></p>
				<p>
					<% if @bank.website_url.present? %>
						<%= link_to @bank.website_url, @bank.website_url, target: "_blank", rel: "noopener" %>
					<% else %>
						-
					<% end %>
				</p>
			</div>
		</div>
	</div>
	<div class="col-lg-8">
		<div class="card h-100">
			<div class="card-body">
				<h2 class="h5"><%= t("admin.banks.description") %></h2>
				<p class="mb-0"><%= @bank.description.presence || "-" %></p>
			</div>
		</div>
	</div>
</div>

<div class="table-box">
	<div class="p-3 border-bottom d-flex justify-content-between align-items-center">
		<h2 class="h5 mb-0"><%= t("admin.banks.loan_offers") %></h2>
		<%= link_to t("admin.loan_offers.new"), new_admin_loan_offer_path(loan_offer: { bank_id: @bank.id }), class: "btn btn-sm btn-primary" %>
	</div>
	<div class="table-responsive">
		<table class="table mb-0">
			<thead class="admin-table-head">
				<tr>
					<th><%= t("admin.loan_offers.table.title") %></th>
					<th><%= t("admin.loan_offers.table.margin") %></th>
					<th><%= t("admin.loan_offers.table.wibor") %></th>
					<th><%= t("admin.loan_offers.table.active") %></th>
				</tr>
			</thead>
			<tbody>
				<% @loan_offers.each do |loan_offer| %>
					<tr>
						<td><%= link_to loan_offer.title, admin_loan_offer_path(loan_offer) %></td>
						<td><%= loan_offer.bank_margin_percent %>%</td>
						<td><%= loan_offer.wibor_kind.upcase %></td>
						<td><%= loan_offer.active? ? t("common.yes") : t("common.no") %></td>
					</tr>
				<% end %>
			</tbody>
		</table>
	</div>
</div>
