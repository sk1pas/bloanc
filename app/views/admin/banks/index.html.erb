<% content_for :title, t("admin.banks.title") %>

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1 class="h3 mb-0"><%= t("admin.banks.title") %></h1>
	<%= link_to t("admin.banks.new"), new_admin_bank_path, class: "btn btn-primary" %>
</div>

<div class="table-box">
	<div class="table-responsive">
		<table class="table mb-0">
			<thead class="admin-table-head">
				<tr>
					<th><%= t("admin.banks.table.logo") %></th>
					<th><%= t("admin.banks.table.title") %></th>
					<th><%= t("admin.banks.table.loan_offers") %></th>
					<th class="text-end"><%= t("admin.banks.table.actions") %></th>
				</tr>
			</thead>
			<tbody>
				<% @banks.each do |bank| %>
					<tr>
						<td>
							<% if bank.logo.attached? %>
								<%= image_tag bank.logo, class: "bank-logo", alt: bank.title %>
							<% end %>
						</td>
						<td><strong><%= bank.title %></strong></td>
						<td><%= bank.loan_offers.count %></td>
						<td class="text-end">
							<div class="admin-actions-group">
								<%= link_to t("actions.show"), admin_bank_path(bank), class: "btn btn-sm btn-outline-light" %>
								<%= link_to t("actions.edit"), edit_admin_bank_path(bank), class: "btn btn-sm btn-outline-info" %>
								<%= button_to t("actions.delete"),
															admin_bank_path(bank),
															method: :delete,
															class: "btn btn-sm btn-outline-danger",
															form: { data: { turbo_confirm: t("admin.banks.confirm_delete") } } %>
							</div>
						</td>
					</tr>
				<% end %>
			</tbody>
		</table>
	</div>
</div>
