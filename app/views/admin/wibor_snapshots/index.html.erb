<% content_for :title, t("admin.wibor.title") %>

<div class="d-flex justify-content-between align-items-center mb-3">
	<h1 class="h3 mb-0"><%= t("admin.wibor.title") %></h1>
	<%= button_to t("admin.wibor.refresh"), refresh_admin_wibor_snapshots_path, method: :post, class: "btn btn-primary" %>
</div>

<div class="card mb-4">
	<div class="card-body">
		<h2 class="h5"><%= t("admin.wibor.latest_title") %></h2>
		<% if @latest_snapshot.present? %>
			<p class="mb-1"><%= t("admin.wibor.latest_date") %>: <strong><%= I18n.l(@latest_snapshot.effective_date) %></strong></p>
			<p class="mb-1">WIBOR 1M: <strong><%= @latest_snapshot.wibor_1m %>%</strong></p>
			<p class="mb-1">WIBOR 3M: <strong><%= @latest_snapshot.wibor_3m %>%</strong></p>
			<p class="mb-0"><%= t("admin.wibor.last_refresh") %>: <%= l(@latest_snapshot.fetched_at) %></p>
		<% else %>
			<p class="mb-0 text-warning"><%= t("admin.wibor.empty") %></p>
		<% end %>
	</div>
</div>

<div class="table-box">
	<div class="table-responsive">
		<table class="table mb-0">
			<thead class="admin-table-head">
				<tr>
					<th><%= t("admin.wibor.table.effective_date") %></th>
					<th><%= t("admin.wibor.table.wibor_1m") %></th>
					<th><%= t("admin.wibor.table.wibor_3m") %></th>
					<th><%= t("admin.wibor.table.fetched_at") %></th>
				</tr>
			</thead>
			<tbody>
				<% @snapshots.each do |snapshot| %>
					<tr>
						<td><%= I18n.l(snapshot.effective_date) %></td>
						<td><%= snapshot.wibor_1m %>%</td>
						<td><%= snapshot.wibor_3m %>%</td>
						<td><%= l(snapshot.fetched_at) %></td>
					</tr>
				<% end %>
			</tbody>
		</table>
	</div>
</div>
