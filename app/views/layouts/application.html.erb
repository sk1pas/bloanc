<!DOCTYPE html>
<html lang="<%= hreflang_for(I18n.locale) %>">
  <head>
    <% page_title = content_for(:title) || t("seo.site_name", default: "wCredit.pl") %>
    <% meta_description = content_for(:meta_description) || t("seo.description", default: "Compare Polish mortgage offers with transparent monthly and total costs.") %>
    <% meta_keywords = t("seo.keywords", default: "mortgage, mortgage comparison, Poland, WIBOR, loan calculator") %>
    <% current_rate_type = @rate_type.presence || "variable" %>
    <% canonical_url = loan_comparison_url(
         locale: I18n.locale,
         rate_type_slug: RateTypeSlug.slug_for(locale: I18n.locale, rate_type: current_rate_type),
         only_path: false
       ) %>

    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= meta_description %>">
    <meta name="keywords" content="<%= meta_keywords %>">
    <meta name="author" content="wCredit.pl">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
    <meta name="theme-color" content="#0f5e9c">
    <link rel="canonical" href="<%= canonical_url %>">

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <% available_locales.each do |locale| %>
      <link rel="alternate" hreflang="<%= hreflang_for(locale) %>" href="<%= loan_comparison_url(locale: locale, rate_type_slug: RateTypeSlug.slug_for(locale: locale, rate_type: current_rate_type), only_path: false) %>">
    <% end %>
    <link rel="alternate" hreflang="x-default" href="<%= loan_comparison_url(locale: I18n.default_locale, rate_type_slug: RateTypeSlug.slug_for(locale: I18n.default_locale, rate_type: current_rate_type), only_path: false) %>">

    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= meta_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:site_name" content="<%= t("seo.site_name", default: "wCredit.pl") %>">
    <meta property="og:locale" content="<%= I18n.locale %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= meta_description %>">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="wCredit.pl">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% website_schema = {
         "@context" => "https://schema.org",
         "@type" => "WebSite",
         "name" => t("seo.site_name", default: "wCredit.pl"),
         "url" => request.base_url,
         "description" => meta_description,
         "inLanguage" => hreflang_for(I18n.locale)
       } %>
    <script type="application/ld+json"><%= raw(website_schema.to_json) %></script>

    <%= yield :head %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
  </head>

  <body class="public-theme">
    <nav class="navbar navbar-expand-lg public-navbar">
      <div class="container">
        <%= link_to loan_comparison_url_for(locale: I18n.locale, rate_type: "variable"), class: "navbar-brand public-brand" do %>
          <%= image_tag "/logo.png",
                        alt: t("seo.site_name"),
                        class: "public-brand-logo",
                        width: 75,
                        height: 40 %>
        <% end %>
        <label class="locale-switch">
          <span class="visually-hidden"><%= t("common.language") %></span>
          <select class="form-select form-select-sm locale-switch-select"
                  data-controller="locale-switch"
                  data-action="change->locale-switch#go"
                  aria-label="<%= t("common.language") %>">
            <% available_locales.each do |locale| %>
              <option value="<%= loan_comparison_url_for(locale: locale, rate_type: current_rate_type) %>"
                      <%= "selected" if locale == I18n.locale.to_s %>>
                <%= locale_switch_label(locale) %>
              </option>
            <% end %>
          </select>
        </label>
      </div>
    </nav>

    <main class="container pb-5">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/cookie_banner" %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <%= javascript_importmap_tags %>
  </body>
</html>
