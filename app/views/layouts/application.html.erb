<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <% page_title = content_for(:title) || t("seo.site_name", default: "Bloanc") %>
    <% meta_description = content_for(:meta_description) || t("seo.description", default: "Compare Polish mortgage offers with transparent monthly and total costs.") %>
    <% meta_keywords = t("seo.keywords", default: "mortgage, mortgage comparison, Poland, WIBOR, loan calculator") %>
    <% canonical_url = "#{request.base_url}#{request.path}" %>

    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= meta_description %>">
    <meta name="keywords" content="<%= meta_keywords %>">
    <meta name="author" content="bloanc">
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
    <meta name="theme-color" content="#0f5e9c">
    <link rel="canonical" href="<%= canonical_url %>">

    <% available_locales.each do |locale| %>
      <link rel="alternate" hreflang="<%= locale %>" href="<%= url_for(locale: locale, only_path: false) %>">
    <% end %>
    <link rel="alternate" hreflang="x-default" href="<%= url_for(locale: I18n.default_locale, only_path: false) %>">

    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= meta_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:site_name" content="<%= t("seo.site_name", default: "bloanc") %>">
    <meta property="og:locale" content="<%= I18n.locale %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= meta_description %>">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bloanc">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% website_schema = {
         "@context" => "https://schema.org",
         "@type" => "WebSite",
         "name" => t("seo.site_name", default: "bloanc"),
         "url" => request.base_url,
         "description" => meta_description,
         "inLanguage" => I18n.locale.to_s
       } %>
    <script type="application/ld+json"><%= raw(website_schema.to_json) %></script>

    <%= yield :head %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
  </head>

  <body class="public-theme">
    <nav class="navbar navbar-expand-lg public-navbar mb-4">
      <div class="container">
        <%= link_to "bloanc", root_path(locale: I18n.locale), class: "navbar-brand public-brand" %>
        <div class="d-flex align-items-center gap-2">
          <% available_locales.each do |locale| %>
            <%= link_to locale_switch_label(locale),
                        url_for(locale: locale),
                        class: "btn btn-sm locale-switch-btn #{locale == I18n.locale.to_s ? "btn-light" : "btn-outline-light"}",
                        aria: { label: locale.upcase } %>
          <% end %>
          <%= link_to t("nav.admin"), admin_root_path, class: "btn btn-warning btn-sm" %>
        </div>
      </div>
    </nav>

    <main class="container pb-5">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <%= javascript_importmap_tags %>
  </body>
</html>
