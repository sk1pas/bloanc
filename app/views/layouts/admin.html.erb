<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Bloanc Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
  </head>

  <body class="admin-theme">
    <nav class="navbar navbar-expand-lg admin-navbar mb-4">
      <div class="container">
        <%= link_to "bloanc admin", admin_root_path, class: "navbar-brand admin-brand" %>
        <div class="d-flex align-items-center gap-2">
          <%= link_to t("admin.nav.dashboard"), admin_root_path, class: "btn btn-sm btn-outline-light" %>
          <%= link_to t("admin.nav.banks"), admin_banks_path, class: "btn btn-sm btn-outline-light" %>
          <%= link_to t("admin.nav.loan_offers"), admin_loan_offers_path, class: "btn btn-sm btn-outline-light" %>
          <%= link_to t("admin.nav.wibor"), admin_wibor_snapshots_path, class: "btn btn-sm btn-outline-light" %>
          <%= link_to t("admin.nav.public"), root_path(locale: I18n.default_locale), class: "btn btn-sm btn-info" %>
        </div>
      </div>
    </nav>

    <main class="container pb-5">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <%= javascript_importmap_tags %>
  </body>
</html>
