<% content_for :title, t("home.seo.#{@rate_type}.title") %>
<% content_for :meta_description, t("home.seo.#{@rate_type}.description") %>
<% content_for :head do %>
	<meta name="turbo-cache-control" content="no-cache">
<% end %>

<section class="card hero-card mb-3">
	<div class="card-body hero-card-body">
		<div class="hero-intro text-center">
			<h1 class="h2 mb-2"><%= t("home.hero.title") %></h1>
			<p class="text-secondary mb-0"><%= t("home.hero.subtitle") %></p>
		</div>

		<%= form_with url: comparison_results_path,
									method: :get,
									class: "hero-form",
									data: {
										controller: "comparison-form",
										action: "submit->comparison-form#markScrollToResults"
									} do |form| %>
			<% fixed_monthly_slider_max = [[[@loan_amount.to_i / 8, 10_000].max, 20_000].min, 1_000].max %>
			<% fixed_monthly_slider_value = [[@fixed_monthly_payment.to_i, fixed_monthly_slider_max].min, 1_000].max %>
			<%= hidden_field_tag :rate_type, @rate_type %>
			<%= hidden_field_tag :sort_key, @sort_key %>
			<%= hidden_field_tag :sort_direction, @sort_direction %>

			<div class="hero-form-row row g-3 justify-content-center">
				<div class="col-sm-8 col-md-5 col-lg-4">
					<div class="hero-field">
						<%= form.label :loan_amount, t("home.form.loan_amount"), class: "form-label" %>
						<div class="slider-field">
							<div class="slider-field__input-row">
								<button type="button"
												class="slider-field__btn"
												aria-label="-"
												data-action="comparison-form#nudgeRange"
												data-range-target="loanAmountRange"
												data-range-direction="-1">−</button>
								<%= form.number_field :loan_amount,
															value: @loan_amount,
															class: "form-control slider-field__input",
															min: 50_000,
															max: 2_500_000,
															step: 1000,
															required: true,
															data: {
																comparison_form_target: "loanAmountInput",
																action: "input->comparison-form#syncLoanAmountFromInput change->comparison-form#syncLoanAmountFromInput"
															} %>
								<button type="button"
												class="slider-field__btn"
												aria-label="+"
												data-action="comparison-form#nudgeRange"
												data-range-target="loanAmountRange"
												data-range-direction="1">+</button>
							</div>
							<div class="slider-field__range-row">
								<%= labeled_range_tag "loan_amount_range",
																		t("home.form.loan_amount"),
																		min: 50_000,
																		max: 2_500_000,
																		step: 5_000,
																		value: @loan_amount,
																		class: "form-range slider-field__range",
																		data: {
																			comparison_form_target: "loanAmountRange",
																			action: "input->comparison-form#syncLoanAmountFromRange"
																		} %>
							</div>
						</div>
					</div>
				</div>

				<div class="col-sm-8 col-md-4 col-lg-3">
					<div class="hero-field">
						<%= form.label :years, t("home.form.years"), class: "form-label" %>
						<div class="slider-field">
							<div class="slider-field__input-row">
								<button type="button"
												class="slider-field__btn"
												aria-label="-"
												data-action="comparison-form#nudgeRange"
												data-range-target="yearsRange"
												data-range-direction="-1">−</button>
								<%= form.number_field :years,
															value: @loan_years,
															class: "form-control slider-field__input",
															min: 1,
															max: 30,
															step: 1,
															required: true,
															data: {
																comparison_form_target: "yearsInput",
																action: "input->comparison-form#syncYearsFromInput change->comparison-form#syncYearsFromInput"
															} %>
								<button type="button"
												class="slider-field__btn"
												aria-label="+"
												data-action="comparison-form#nudgeRange"
												data-range-target="yearsRange"
												data-range-direction="1">+</button>
							</div>
							<div class="slider-field__range-row">
								<%= labeled_range_tag "years_range",
																		t("home.form.years"),
																		min: 1,
																		max: 30,
																		step: 1,
																		value: @loan_years,
																		class: "form-range slider-field__range",
																		data: {
																			comparison_form_target: "yearsRange",
																			action: "input->comparison-form#syncYearsFromRange"
																		} %>
							</div>
						</div>
					</div>
				</div>
			</div>

			<details class="overpayment-options"
								<%= "open" if overpayment_options_expanded? %>
								data-controller="details-cookie"
								data-details-cookie-key-value="overpayment_options_open"
								data-action="toggle->details-cookie#persist">
				<summary class="overpayment-options__summary">
					<span class="overpayment-options__heading">
						<span class="overpayment-options__title"><%= t("home.overpayment.title") %></span>
						<span class="overpayment-options__hint"><%= t("home.overpayment.subtitle") %></span>
					</span>
				</summary>
				<div class="overpayment-options__body hero-form-row row g-3 justify-content-center">
					<div class="col-md-4 overpayment-option">
						<label class="simulation-option">
							<span class="simulation-option-radio">
								<%= form.radio_button :overpayment_mode,
																		"none",
																		checked: @overpayment_mode == "none",
																		class: "form-check-input",
																		data: {
																			comparison_form_target: "modeRadio",
																			action: "change->comparison-form#modeChanged"
																		} %>
							</span>
							<span class="simulation-option-body">
								<span class="simulation-option-title"><%= t("home.overpayment.mode.none_title") %></span>
								<span class="simulation-option-desc"><%= t("home.overpayment.mode.none_desc") %></span>
							</span>
						</label>
					</div>

					<div class="col-md-4 overpayment-option">
						<label class="simulation-option">
							<span class="simulation-option-radio">
								<%= form.radio_button :overpayment_mode,
																		"fixed_monthly",
																		checked: @overpayment_mode == "fixed_monthly",
																		class: "form-check-input",
																		data: {
																			comparison_form_target: "modeRadio",
																			action: "change->comparison-form#modeChanged"
																		} %>
							</span>
							<span class="simulation-option-body">
							<span class="simulation-option-title"><%= t("home.overpayment.mode.fixed_monthly_title") %></span>
							<span class="simulation-option-desc"><%= t("home.overpayment.mode.fixed_monthly_desc") %></span>
							<div class="simulation-option-fields mt-2 <%= @overpayment_mode == 'fixed_monthly' ? 'show' : '' %>" data-comparison-form-target="fixedMonthlyWrap">
								<span class="simulation-option-field-label"><%= t("home.overpayment.fields.fixed_monthly_payment") %></span>
								<div class="slider-field">
									<div class="slider-field__input-row">
										<button type="button"
														class="slider-field__btn"
														aria-label="-"
														data-action="comparison-form#nudgeRange"
														data-range-target="fixedMonthlyRange"
														data-range-direction="-1">−</button>
										<%= form.number_field :fixed_monthly_payment,
																				value: @fixed_monthly_payment.to_i,
																				class: "form-control form-control-sm slider-field__input",
																				step: 100,
																				min: 0,
																				data: {
																					comparison_form_target: "fixedMonthlyInput",
																					action: "input->comparison-form#syncFixedMonthlyFromInput change->comparison-form#syncFixedMonthlyFromInput"
																				} %>
										<button type="button"
														class="slider-field__btn"
														aria-label="+"
														data-action="comparison-form#nudgeRange"
														data-range-target="fixedMonthlyRange"
														data-range-direction="1">+</button>
									</div>
									<div class="slider-field__range-row">
										<%= labeled_range_tag "fixed_monthly_payment_range",
																					t("home.overpayment.fields.fixed_monthly_payment"),
																					min: 1_000,
																					max: fixed_monthly_slider_max,
																					step: 100,
																					value: fixed_monthly_slider_value,
																					class: "form-range slider-field__range",
																					data: {
																						comparison_form_target: "fixedMonthlyRange",
																						action: "input->comparison-form#syncFixedMonthlyFromRange"
																					} %>
									</div>
								</div>
								<div class="form-check simulation-penalty-check mt-2">
									<%= hidden_field_tag :fixed_monthly_overpay_during_penalty, "0" %>
									<%= check_box_tag :fixed_monthly_overpay_during_penalty,
															"1",
															@fixed_monthly_overpay_during_penalty,
															class: "form-check-input",
															id: "fixed_monthly_overpay_during_penalty_1" %>
									<label for="fixed_monthly_overpay_during_penalty_1" class="form-check-label">
										<%= t("home.overpayment.fields.overpay_during_penalty") %>
									</label>
								</div>
							</div>
							</span>
						</label>
					</div>

					<div class="col-md-4 overpayment-option">
						<label class="simulation-option">
							<span class="simulation-option-radio">
								<%= form.radio_button :overpayment_mode,
																		"fixed_period",
																		checked: @overpayment_mode == "fixed_period",
																		class: "form-check-input",
																		data: {
																			comparison_form_target: "modeRadio",
																			action: "change->comparison-form#modeChanged"
																		} %>
							</span>
							<span class="simulation-option-body">
							<span class="simulation-option-title"><%= t("home.overpayment.mode.fixed_period_title") %></span>
							<span class="simulation-option-desc"><%= t("home.overpayment.mode.fixed_period_desc") %></span>
							<div class="simulation-option-fields mt-2	<%= @overpayment_mode == 'fixed_period' ? 'show' : '' %>" data-comparison-form-target="fixedPeriodWrap">
								<span class="simulation-option-field-label"><%= t("home.overpayment.fields.target_years") %></span>
								<div class="slider-field">
									<div class="slider-field__input-row">
										<button type="button"
														class="slider-field__btn"
														aria-label="-"
														data-action="comparison-form#nudgeRange"
														data-range-target="targetYearsRange"
														data-range-direction="-1">−</button>
										<%= form.number_field :target_years,
																				value: @target_years,
																				class: "form-control form-control-sm slider-field__input",
																				step: 1,
																				min: 1,
																				max: [@loan_years - 1, 1].max,
																				data: {
																					comparison_form_target: "targetYearsInput",
																					action: "input->comparison-form#syncTargetYearsFromInput change->comparison-form#syncTargetYearsFromInput"
																				} %>
										<button type="button"
														class="slider-field__btn"
														aria-label="+"
														data-action="comparison-form#nudgeRange"
														data-range-target="targetYearsRange"
														data-range-direction="1">+</button>
									</div>
									<div class="slider-field__range-row">
										<%= labeled_range_tag "target_years_range",
																					t("home.overpayment.fields.target_years"),
																					min: 1,
																					max: [@loan_years - 1, 1].max,
																					step: 1,
																					value: @target_years,
																					class: "form-range slider-field__range",
																					data: {
																						comparison_form_target: "targetYearsRange",
																						action: "input->comparison-form#syncTargetYearsFromRange"
																					} %>
									</div>
								</div>
								<div class="form-check simulation-penalty-check mt-2">
									<%= hidden_field_tag :fixed_period_overpay_during_penalty, "0" %>
									<%= check_box_tag :fixed_period_overpay_during_penalty,
															"1",
															@fixed_period_overpay_during_penalty,
															class: "form-check-input",
															id: "fixed_period_overpay_during_penalty_1" %>
									<label for="fixed_period_overpay_during_penalty_1" class="form-check-label">
										<%= t("home.overpayment.fields.overpay_during_penalty") %>
									</label>
								</div>
							</div>
							</span>
						</label>
					</div>
				</div>
			</details>

			<div class="hero-form-actions">
				<%= form.submit t("home.form.calculate"), class: "btn btn-primary btn-lg px-4" %>
			</div>
		<% end %>
	</div>
</section>

<details class="table-box payment-parts mb-3"
					<%= "open" if payment_parts_expanded? %>
					data-controller="details-cookie"
					data-details-cookie-key-value="payment_parts_open"
					data-action="toggle->details-cookie#persist">
	<summary class="payment-parts__summary">
		<h2 id="payment-parts-heading" class="payment-parts__heading"><%= t("home.payment_parts.heading") %></h2>
	</summary>
	<ol class="payment-parts__formula">
		<li class="payment-parts__item">
			<span class="payment-parts__emoji" aria-hidden="true">🏦</span>
			<span class="payment-parts__title"><%= t("home.payment_parts.credit.title") %></span>
			<span class="payment-parts__note"><%= t("home.payment_parts.credit.note") %></span>
		</li>
		<li class="payment-parts__plus" aria-hidden="true">+</li>
		<li class="payment-parts__item">
			<span class="payment-parts__emoji" aria-hidden="true">🛡️</span>
			<span class="payment-parts__title"><%= t("home.payment_parts.life.title") %></span>
			<span class="payment-parts__note"><%= t("home.payment_parts.life.note") %></span>
		</li>
		<li class="payment-parts__plus" aria-hidden="true">+</li>
		<li class="payment-parts__item">
			<span class="payment-parts__emoji" aria-hidden="true">🏠</span>
			<span class="payment-parts__title"><%= t("home.payment_parts.property.title") %></span>
			<span class="payment-parts__note"><%= t("home.payment_parts.property.note") %></span>
		</li>
		<li class="payment-parts__plus" aria-hidden="true">+</li>
		<li class="payment-parts__item">
			<span class="payment-parts__emoji" aria-hidden="true">💳</span>
			<span class="payment-parts__title"><%= t("home.payment_parts.other.title") %></span>
			<span class="payment-parts__note"><%= t("home.payment_parts.other.note") %></span>
		</li>
	</ol>
</details>

<section class="table-box wibor-snapshot mb-3" aria-label="<%= t("home.wibor.latest") %>">
	<% if @wibor_snapshot.present? %>
		<div class="wibor-snapshot__line">
			<span class="wibor-snapshot__item">
				<span class="wibor-snapshot__label"><%= t("home.wibor.date") %></span>
				<strong><%= I18n.l(@wibor_snapshot.updated_at.to_date) %></strong>
			</span>
			<span class="wibor-snapshot__item">
				<span class="wibor-snapshot__label">WIBOR 1M</span>
				<strong><%= number_with_precision(@wibor_snapshot.wibor_1m, precision: 2, strip_insignificant_zeros: true) %>%</strong>
				<%= wibor_change_indicator(@wibor_snapshot.wibor_1m, @previous_wibor_snapshot&.wibor_1m) %>
			</span>
			<span class="wibor-snapshot__item">
				<span class="wibor-snapshot__label">WIBOR 3M</span>
				<strong><%= number_with_precision(@wibor_snapshot.wibor_3m, precision: 2, strip_insignificant_zeros: true) %>%</strong>
				<%= wibor_change_indicator(@wibor_snapshot.wibor_3m, @previous_wibor_snapshot&.wibor_3m) %>
			</span>
		</div>
	<% else %>
		<p class="form-hint mb-0"><%= t("home.wibor.missing") %></p>
	<% end %>
</section>

<% rate_switch_params = {
		 loan_amount: @loan_amount,
		 years: @loan_years,
		 overpayment_mode: @overpayment_mode,
		 fixed_monthly_payment: @fixed_monthly_payment,
		 target_years: @target_years,
		 fixed_monthly_overpay_during_penalty: @fixed_monthly_overpay_during_penalty ? "1" : "0",
		 fixed_period_overpay_during_penalty: @fixed_period_overpay_during_penalty ? "1" : "0"
	 }.merge(comparison_sort_params) %>

<%= render "comparison_results", rate_switch_params: rate_switch_params %>

<section class="comparison-guide mb-3" aria-labelledby="comparison-guide-heading">
	<h2 id="comparison-guide-heading" class="comparison-guide__title"><%= t("home.comparison_guide.title") %></h2>
	<p class="comparison-guide__intro"><%= sanitize(t("home.comparison_guide.intro"), tags: %w[strong]) %></p>
	<div class="comparison-guide__blocks">
		<article class="comparison-guide__block">
			<h3 class="comparison-guide__heading"><%= t("home.comparison_guide.calculator.title") %></h3>
			<p class="comparison-guide__body"><%= sanitize(t("home.comparison_guide.calculator.body"), tags: %w[strong]) %></p>
		</article>
		<article class="comparison-guide__block">
			<h3 class="comparison-guide__heading"><%= t("home.comparison_guide.comparison.title") %></h3>
			<p class="comparison-guide__body"><%= sanitize(t("home.comparison_guide.comparison.body"), tags: %w[strong]) %></p>
		</article>
		<article class="comparison-guide__block">
			<h3 class="comparison-guide__heading"><%= t("home.comparison_guide.rates.title") %></h3>
			<p class="comparison-guide__body"><%= sanitize(t("home.comparison_guide.rates.body"), tags: %w[strong]) %></p>
		</article>
		<article class="comparison-guide__block">
			<h3 class="comparison-guide__heading"><%= t("home.comparison_guide.best_bank.title") %></h3>
			<p class="comparison-guide__body"><%= sanitize(t("home.comparison_guide.best_bank.body"), tags: %w[strong]) %></p>
		</article>
	</div>
</section>

<% if false # temporary: hide custom bank offer block %>
<section class="card section-card">
	<div class="card-body p-4">
		<h2 class="h4 mb-2"><%= t("home.custom.title") %></h2>
		<p class="text-secondary"><%= t("home.custom.subtitle") %></p>

		<%= form_with url: custom_compare_path(locale: I18n.locale), method: :post, class: "row g-3" do |form| %>
			<%= hidden_field_tag :loan_amount, @loan_amount %>
			<%= hidden_field_tag :years, @loan_years %>
			<%= hidden_field_tag :rate_type, @rate_type %>
			<%= hidden_field_tag :overpayment_mode, @overpayment_mode %>
			<%= hidden_field_tag :fixed_monthly_payment, @fixed_monthly_payment %>
			<%= hidden_field_tag :target_years, @target_years %>
			<%= hidden_field_tag :fixed_monthly_overpay_during_penalty, @fixed_monthly_overpay_during_penalty ? "1" : "0" %>
			<%= hidden_field_tag :fixed_period_overpay_during_penalty, @fixed_period_overpay_during_penalty ? "1" : "0" %>

			<div class="col-md-4">
				<%= form.label :bank_title, t("home.custom.form.bank_title"), class: "form-label" %>
				<%= form.text_field :bank_title, name: "custom_offer[bank_title]", value: @custom_offer["bank_title"], class: "form-control" %>
			</div>
			<div class="col-md-4">
				<%= form.label :title, t("home.custom.form.offer_title"), class: "form-label" %>
				<%= form.text_field :title, name: "custom_offer[title]", value: @custom_offer["title"], class: "form-control" %>
			</div>
			<div class="col-md-4">
				<%= form.label :custom_rate_type, t("home.custom.form.rate_type"), class: "form-label" %>
				<%= form.select :rate_type,
											options_for_select([
												[t("home.rate_type.tabs.variable"), "variable"],
												[t("home.rate_type.tabs.fixed_period"), "fixed_period"]
											], @custom_offer["rate_type"] || @rate_type || "variable"),
											{},
											name: "custom_offer[rate_type]",
											class: "form-select",
                      id: "custom_rate_type" %>
			</div>
			<div class="col-md-4">
				<%= form.label :bank_margin_percent, t("home.custom.form.bank_margin_percent"), class: "form-label" %>
				<%= form.number_field :bank_margin_percent, name: "custom_offer[bank_margin_percent]", value: @custom_offer["bank_margin_percent"], class: "form-control", step: "0.001", required: true %>
			</div>
			<div class="col-12">
				<%= form.label :description, t("home.custom.form.description"), class: "form-label" %>
				<%= form.text_area :description, name: "custom_offer[description]", value: @custom_offer["description"], class: "form-control", rows: 2 %>
			</div>
			<div class="col-md-4">
				<%= form.label :fixed_rate_percent, t("home.custom.form.fixed_rate_percent"), class: "form-label" %>
				<%= form.number_field :fixed_rate_percent, name: "custom_offer[fixed_rate_percent]", value: @custom_offer["fixed_rate_percent"], class: "form-control", step: "0.001" %>
			</div>
			<div class="col-md-4">
				<%= form.label :fixed_rate_years, t("home.custom.form.fixed_rate_years"), class: "form-label" %>
				<%= form.number_field :fixed_rate_years, name: "custom_offer[fixed_rate_years]", value: @custom_offer["fixed_rate_years"], class: "form-control", step: 1 %>
			</div>
			<div class="col-md-4">
				<%= form.label :wibor_kind, t("home.custom.form.wibor_kind"), class: "form-label" %>
				<%= form.select :wibor_kind,
												options_for_select([["WIBOR 1M", "wibor_1m"], ["WIBOR 3M", "wibor_3m"]], @custom_offer["wibor_kind"] || "wibor_3m"),
												{},
												name: "custom_offer[wibor_kind]",
												class: "form-select" %>
			</div>
			<div class="col-md-4">
				<%= form.label :wibor_percent, t("home.custom.form.wibor_percent"), class: "form-label" %>
				<%= form.number_field :wibor_percent, name: "custom_offer[wibor_percent]", value: @custom_offer["wibor_percent"], class: "form-control", step: "0.001" %>
			</div>
			<div class="col-md-4">
				<%= form.label :bank_commission_percent, t("home.custom.form.bank_commission_percent"), class: "form-label" %>
				<%= form.number_field :bank_commission_percent, name: "custom_offer[bank_commission_percent]", value: @custom_offer["bank_commission_percent"], class: "form-control", step: "0.001" %>
			</div>
			<div class="col-md-3">
				<%= form.label :life_insurance_percent, t("home.custom.form.life_insurance_percent"), class: "form-label" %>
				<%= form.number_field :life_insurance_percent, name: "custom_offer[life_insurance_percent]", value: @custom_offer["life_insurance_percent"], class: "form-control", step: "0.0001" %>
				<div class="form-check mt-2">
					<%= hidden_field_tag "custom_offer[life_insurance_one_time]", "0", id: nil %>
					<%= check_box_tag "custom_offer[life_insurance_one_time]",
														"1",
														ActiveModel::Type::Boolean.new.cast(@custom_offer["life_insurance_one_time"]),
														class: "form-check-input",
														id: "custom_life_insurance_one_time" %>
					<%= label_tag "custom_life_insurance_one_time", t("home.custom.form.life_insurance_one_time"), class: "form-check-label" %>
				</div>
			</div>
			<div class="col-md-3">
				<%= form.label :life_insurance_years, t("home.custom.form.life_insurance_years"), class: "form-label" %>
				<%= form.number_field :life_insurance_years, name: "custom_offer[life_insurance_years]", value: @custom_offer["life_insurance_years"], class: "form-control", step: 1 %>
			</div>
			<div class="col-md-3">
				<%= form.label :life_insurance_total, t("home.custom.form.life_insurance_total"), class: "form-label" %>
				<%= form.number_field :life_insurance_total, name: "custom_offer[life_insurance_total]", value: @custom_offer["life_insurance_total"], class: "form-control", step: "0.01" %>
			</div>
			<div class="col-md-3">
				<%= form.label :property_insurance_monthly, t("home.custom.form.property_insurance_monthly"), class: "form-label" %>
				<%= form.number_field :property_insurance_monthly, name: "custom_offer[property_insurance_monthly]", value: @custom_offer["property_insurance_monthly"], class: "form-control", step: "0.01" %>
			</div>
			<div class="col-md-3">
				<%= form.label :overpayment_grace_years, t("home.custom.form.overpayment_grace_years"), class: "form-label" %>
				<%= form.number_field :overpayment_grace_years, name: "custom_offer[overpayment_grace_years]", value: @custom_offer["overpayment_grace_years"], class: "form-control", step: 1 %>
			</div>
			<div class="col-md-3">
				<%= form.label :custom_overpayment_mode, t("home.custom.form.overpayment_mode"), class: "form-label" %>
				<%= form.select :overpayment_mode,
												options_for_select([
													[t("home.custom.overpayment.none"), "none"],
													[t("home.custom.overpayment.coef"), "coef"],
													[t("home.custom.overpayment.absolute"), "absolute"]
												], @custom_offer["overpayment_mode"] || "none"),
												{},
												name: "custom_offer[overpayment_mode]",
												class: "form-select",
                        id: "custom_overpayment_mode" %>
			</div>
			<div class="col-md-3">
				<%= form.label :overpayment_coef, t("home.custom.form.overpayment_coef"), class: "form-label" %>
				<%= form.number_field :overpayment_coef, name: "custom_offer[overpayment_coef]", value: @custom_offer["overpayment_coef"], class: "form-control", step: "0.01" %>
			</div>
			<div class="col-md-3">
				<%= form.label :overpayment_amount, t("home.custom.form.overpayment_amount"), class: "form-label" %>
				<%= form.number_field :overpayment_amount, name: "custom_offer[overpayment_amount]", value: @custom_offer["overpayment_amount"], class: "form-control", step: "0.01" %>
			</div>
			<div class="col-md-4">
				<%= form.label :overpayment_penalty_years, t("home.custom.form.overpayment_penalty_years"), class: "form-label" %>
				<%= form.number_field :overpayment_penalty_years, name: "custom_offer[overpayment_penalty_years]", value: @custom_offer["overpayment_penalty_years"], class: "form-control", step: 1 %>
			</div>
			<div class="col-md-4">
				<%= form.label :overpayment_penalty_percent, t("home.custom.form.overpayment_penalty_percent"), class: "form-label" %>
				<%= form.number_field :overpayment_penalty_percent, name: "custom_offer[overpayment_penalty_percent]", value: @custom_offer["overpayment_penalty_percent"], class: "form-control", step: "0.01" %>
			</div>
			<div class="col-md-4">
				<%= form.label :overpayment_penalty_min_amount, t("home.custom.form.overpayment_penalty_min_amount"), class: "form-label" %>
				<%= form.number_field :overpayment_penalty_min_amount, name: "custom_offer[overpayment_penalty_min_amount]", value: @custom_offer["overpayment_penalty_min_amount"], class: "form-control", step: "0.01" %>
			</div>
			<div class="col-12 d-grid d-md-flex justify-content-md-end">
				<%= form.submit t("home.custom.form.calculate"), class: "btn btn-success" %>
			</div>
		<% end %>

		<% if @custom_result.present? %>
			<div class="alert alert-info mt-4 mb-0">
				<h3 class="h6"><%= t("home.custom.result_title") %></h3>
				<p class="mb-1"><strong><%= @custom_result[:bank_title] %></strong> | <%= @custom_result[:offer_title] %></p>
				<p class="mb-1"><%= t("home.results.monthly") %>: <strong><%= number_to_currency(@custom_result[:monthly_payment], unit: "PLN", precision: 0, format: "%n %u") %></strong></p>
				<p class="mb-1"><%= t("home.results.total_paid") %>: <strong><%= number_to_currency(@custom_result[:total_paid], unit: "PLN", precision: 0, format: "%n %u") %></strong></p>
				<p class="mb-0"><%= t("home.results.total_cost") %>: <strong><%= number_to_currency(@custom_result[:total_cost], unit: "PLN", precision: 0, format: "%n %u") %></strong></p>
			</div>
		<% end %>
	</div>
</section>
<% end %>
