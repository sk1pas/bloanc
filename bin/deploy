#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> Stopping app"
bin/kamal app stop || true

echo "==> Freeing host port 3000"
bin/kamal server exec --raw -- \
  'ids=$(docker ps -aq --filter publish=3000); if [ -n "$ids" ]; then docker stop $ids; docker rm -f $ids; fi'

echo "==> Deploying"
bin/kamal deploy

echo "==> Running migrations (reuse running web container)"
# Do not use a fresh `app exec` container here: it inherits publish="127.0.0.1:3000:80"
# and fails with "port is already allocated" while the web container is running.
bin/kamal app exec --reuse --raw -- \
  'bin/rails db:migrate'

echo "==> Removing exited containers"
bin/kamal server exec --raw -- \
  'docker container prune -f --filter label=service=bloanc'

echo "==> Deploy finished"
